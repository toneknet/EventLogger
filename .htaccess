<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(?:sqlite|sqlite-wal|sqlite-shm|db)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.|\.(?:sqlite|sqlite-wal|sqlite-shm|db)$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
